# Episode 3 — optional judge backends (copy to .env; never commit secrets).
# With no keys set, demo_ep3.py uses the offline keyword heuristic.

# Jev / TypeSafe (prefer when you have early access)
# JEV_API_KEY=
# TYPESAFE_API_KEY=
# JEV_API_BASE=https://example.invalid/v1

# LLM JSON fallback (used if Jev unavailable)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Force a backend for demos: jev | openai | anthropic | heuristic
# JUDGE_BACKEND=
